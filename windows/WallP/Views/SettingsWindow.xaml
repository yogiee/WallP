<ui:FluentWindow x:Class="WallP.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="WallP Settings"
                 Width="780"
                 Height="600"
                 MinWidth="640"
                 MinHeight="480"
                 Icon="pack://application:,,,/Assets/WallP.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WallP Settings" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView x:Name="Nav"
                               Grid.Column="0"
                               PaneDisplayMode="Left"
                               IsBackButtonVisible="Collapsed"
                               IsPaneToggleVisible="False"
                               OpenPaneLength="220"
                               SelectionChanged="Nav_SelectionChanged">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="GeneralItem" Content="General" Icon="{ui:SymbolIcon Settings24}" />
                    <ui:NavigationViewItem x:Name="CollectionsItem" Content="Collections" Icon="{ui:SymbolIcon Folder24}" />
                    <ui:NavigationViewItem x:Name="TimingItem" Content="Timing" Icon="{ui:SymbolIcon Clock24}" />
                    <ui:NavigationViewItem x:Name="CacheItem" Content="Cache" Icon="{ui:SymbolIcon Storage24}" />
                    <ui:NavigationViewItem x:Name="AboutItem" Content="About" Icon="{ui:SymbolIcon Info24}" />
                </ui:NavigationView.MenuItems>
            </ui:NavigationView>

            <ContentControl x:Name="ContentArea" Grid.Column="1" />
        </Grid>
    </Grid>
</ui:FluentWindow>
