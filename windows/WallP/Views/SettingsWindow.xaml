<ui:FluentWindow x:Class="WallP.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="WallP Settings"
                 Width="720"
                 Height="540"
                 MinWidth="640"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WallP Settings" />

        <ui:NavigationView Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Settings24}" />
                <ui:NavigationViewItem Content="Collections" Icon="{ui:SymbolIcon Folder24}" />
                <ui:NavigationViewItem Content="Timing" Icon="{ui:SymbolIcon Clock24}" />
                <ui:NavigationViewItem Content="Cache" Icon="{ui:SymbolIcon Storage24}" />
                <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
