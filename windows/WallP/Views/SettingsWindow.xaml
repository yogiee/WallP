<ui:FluentWindow x:Class="WallP.Views.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:settings="clr-namespace:WallP.Views.Settings"
                 Title="WallP Settings"
                 Width="780"
                 Height="600"
                 MinWidth="640"
                 MinHeight="480"
                 Icon="pack://application:,,,/Assets/WallP.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WallP Settings" />

        <ui:NavigationView x:Name="Nav"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="220">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="General" Icon="{ui:SymbolIcon Settings24}" TargetPageType="{x:Type settings:GeneralPage}" />
                <ui:NavigationViewItem Content="Collections" Icon="{ui:SymbolIcon Folder24}" TargetPageType="{x:Type settings:CollectionsPage}" />
                <ui:NavigationViewItem Content="Timing" Icon="{ui:SymbolIcon Clock24}" TargetPageType="{x:Type settings:TimingPage}" />
                <ui:NavigationViewItem Content="Cache" Icon="{ui:SymbolIcon Storage24}" TargetPageType="{x:Type settings:CachePage}" />
                <ui:NavigationViewItem Content="About" Icon="{ui:SymbolIcon Info24}" TargetPageType="{x:Type settings:AboutPage}" />
            </ui:NavigationView.MenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
