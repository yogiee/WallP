<ui:FluentWindow x:Class="WallP.Views.TrayPopover"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="340"
                 SizeToContent="Height"
                 WindowStyle="None"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Topmost="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Deactivated="Window_Deactivated">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title + status pill -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBlock Grid.Column="0"
                          Text="WallP"
                          FontTypography="TitleLarge"
                          VerticalAlignment="Center" />
            <Border Grid.Column="1"
                    x:Name="StatusPill"
                    CornerRadius="10"
                    Padding="10,3"
                    VerticalAlignment="Center">
                <ui:TextBlock x:Name="StatusText"
                              Text="Running"
                              FontTypography="Caption"
                              FontWeight="SemiBold" />
            </Border>
        </Grid>

        <!-- Collection display: ComboBox if >1, else just text -->
        <ui:CardControl Grid.Row="1" Margin="0,0,0,12">
            <ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="0,0,8,0" />
                    <StackPanel>
                        <ui:TextBlock x:Name="CollectionLabel"
                                      Text="No collection"
                                      FontTypography="BodyStrong" />
                        <ui:TextBlock x:Name="CollectionMeta"
                                      Text="0 images"
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="CollectionPicker"
                      MinWidth="120"
                      Visibility="Collapsed"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"
                      SelectionChanged="CollectionPicker_SelectionChanged" />
        </ui:CardControl>

        <!-- Controls row: Shuffle | Pause/Play | Sync -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0"
                       x:Name="ShuffleButton"
                       HorizontalAlignment="Stretch"
                       Margin="0,0,4,0"
                       ToolTip="Shuffle"
                       Click="Shuffle_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowShuffle24" />
                    <ui:TextBlock Text="Shuffle" Margin="6,0,0,0" />
                </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="1"
                       x:Name="PlayPauseButton"
                       HorizontalAlignment="Stretch"
                       Appearance="Primary"
                       Margin="4,0,4,0"
                       Click="PlayPause_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon x:Name="PlayPauseIcon" Symbol="Pause24" />
                    <ui:TextBlock x:Name="PlayPauseLabel" Text="Pause" Margin="6,0,0,0" />
                </StackPanel>
            </ui:Button>
            <ui:Button Grid.Column="2"
                       x:Name="SyncButton"
                       HorizontalAlignment="Stretch"
                       Margin="4,0,0,0"
                       ToolTip="Sync now"
                       Click="Sync_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowSync24" />
                    <ui:TextBlock Text="Sync" Margin="6,0,0,0" />
                </StackPanel>
            </ui:Button>
        </Grid>

        <!-- Setup prompt or status message -->
        <ui:TextBlock Grid.Row="3"
                      x:Name="StatusMessage"
                      Text=""
                      FontTypography="Caption"
                      Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,8"
                      TextWrapping="Wrap"
                      Visibility="Collapsed" />

        <!-- Footer: Settings | Quit -->
        <Grid Grid.Row="4" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:HyperlinkButton Grid.Column="0"
                                x:Name="SettingsLink"
                                Content="Settings…"
                                Click="Settings_Click" />
            <ui:HyperlinkButton Grid.Column="1"
                                x:Name="QuitLink"
                                Content="Quit"
                                Click="Quit_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
