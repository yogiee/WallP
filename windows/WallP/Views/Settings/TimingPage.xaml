<Page x:Class="WallP.Views.Settings.TimingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="640" HorizontalAlignment="Stretch">

            <ui:TextBlock Text="Timing"
                          FontTypography="TitleLarge"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Margin="0,0,0,16" />

            <!-- Wallpaper rotation -->
            <ui:CardExpander Margin="0,0,0,12" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Wallpaper rotation" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="How often the wallpaper changes, and what order images appear in."
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel Margin="4">
                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <ui:TextBlock Text="Change wallpaper" />
                        </ui:CardControl.Header>
                        <ComboBox x:Name="RotationIntervalPicker"
                                  MinWidth="180"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectionChanged="RotationIntervalPicker_SelectionChanged" />
                    </ui:CardControl>

                    <ui:CardControl>
                        <ui:CardControl.Header>
                            <ui:TextBlock Text="Display order" />
                        </ui:CardControl.Header>
                        <ComboBox x:Name="DisplayOrderPicker"
                                  MinWidth="180"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectionChanged="DisplayOrderPicker_SelectionChanged" />
                    </ui:CardControl>
                </StackPanel>
            </ui:CardExpander>

            <!-- Wallhaven sync -->
            <ui:CardExpander Margin="0,0,0,12" IsExpanded="True">
                <ui:CardExpander.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Wallhaven sync" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="How often new wallpapers are pulled from your collections."
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardExpander.Header>

                <StackPanel Margin="4">
                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <ui:TextBlock Text="Check for new wallpapers" />
                        </ui:CardControl.Header>
                        <ComboBox x:Name="SyncIntervalPicker"
                                  MinWidth="180"
                                  DisplayMemberPath="Display"
                                  SelectedValuePath="Value"
                                  SelectionChanged="SyncIntervalPicker_SelectionChanged" />
                    </ui:CardControl>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="SyncNowButton"
                                   Grid.Column="0"
                                   Content="Sync now"
                                   Appearance="Primary"
                                   Click="SyncNow_Click" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center">
                            <ui:ProgressRing x:Name="SyncSpinner"
                                             IsIndeterminate="True"
                                             Width="20"
                                             Height="20"
                                             Visibility="Collapsed" />
                            <ui:TextBlock x:Name="SyncStatusLabel"
                                          FontTypography="Caption"
                                          VerticalAlignment="Center"
                                          Margin="6,0,0,0"
                                          Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:CardExpander>

            <!-- Default collection -->
            <ui:CardControl Margin="0,0,0,12">
                <ui:CardControl.Header>
                    <StackPanel>
                        <ui:TextBlock Text="Default collection" FontTypography="BodyStrong" />
                        <ui:TextBlock Text="The collection used when no Focus mode override applies."
                                      FontTypography="Caption"
                                      Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="DefaultCollectionPicker"
                          MinWidth="220"
                          DisplayMemberPath="Display"
                          SelectedValuePath="Value"
                          SelectionChanged="DefaultCollectionPicker_SelectionChanged" />
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>
