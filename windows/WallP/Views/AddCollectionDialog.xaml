<ui:FluentWindow x:Class="WallP.Views.AddCollectionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Add Wallhaven collection"
                 Width="460"
                 Height="340"
                 ResizeMode="NoResize"
                 ShowInTaskbar="False"
                 Icon="pack://application:,,,/Assets/WallP.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Add Wallhaven collection" />

        <StackPanel Grid.Row="1" Margin="20,12,20,0">
            <ui:TextBlock Text="Wallhaven username" Margin="0,0,0,4" />
            <ui:TextBox x:Name="UsernameBox"
                        PlaceholderText="e.g. yogiee"
                        Margin="0,0,0,12" />

            <ui:TextBlock Text="Collection ID" Margin="0,0,0,4" />
            <ui:TextBox x:Name="CollectionIdBox"
                        PlaceholderText="The numeric ID at the end of the collection URL"
                        Margin="0,0,0,12" />

            <ui:TextBlock Text="Display name" Margin="0,0,0,4" />
            <ui:TextBox x:Name="DisplayNameBox"
                        PlaceholderText="A label to show in the menu"
                        Margin="0,0,0,4" />

            <ui:TextBlock x:Name="ErrorLabel"
                          FontTypography="Caption"
                          Foreground="#E81C3A"
                          Margin="0,8,0,0"
                          Visibility="Collapsed" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="20,0,20,20">
            <ui:Button Content="Cancel"
                       Margin="0,0,8,0"
                       MinWidth="90"
                       Click="Cancel_Click" />
            <ui:Button Content="Add"
                       Appearance="Primary"
                       MinWidth="90"
                       IsDefault="True"
                       Click="Add_Click" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
